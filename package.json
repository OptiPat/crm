{
  "name": "patrimoine-crm",
  "private": true,
  "version": "0.5.69",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite",
    "postinstall": "node scripts/copy-pdf-assets.cjs",
    "prebuild": "node scripts/copy-pdf-assets.cjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:release": "tauri dev --release",
    "tauri:build": "tauri build",
    "icons:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/crop-app-logo.ps1 ; tauri icon src-tauri/icons/app-logo-square.png -o src-tauri/icons",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check:icons": "node scripts/check-lucide-icons.cjs",
    "check:upgrade": "npm run check:icons && tsc --noEmit && npm run build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-rust.ps1",
    "test:all": "npm run test && npm run test:rust",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./verify.ps1",
    "verify:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ./verify.ps1 -Quick",
    "verify:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./verify.ps1 -Build",
    "build:espace-portail": "vite build --config espace-portail/web/vite.config.ts",
    "dev:espace-portail": "vite --config espace-portail/web/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.67.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.5",
    "nanoid": "3.3.20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
