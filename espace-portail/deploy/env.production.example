# Production — copier vers /opt/espace-portail/.env sur le VPS
# Ne jamais commiter le fichier .env reel.

ESPACE_PRODUCTION=1
ESPACE_TRUST_PROXY=1
ESPACE_PORTAL_BIND=127.0.0.1:8787
ESPACE_PORTAL_DB=/opt/espace-portail/data/espace-portail.db
ESPACE_PORTAL_DATA=/opt/espace-portail/data/uploads
ESPACE_PORTAL_STATIC=/opt/espace-portail/web/dist

# Generer avec deploy/generate-sync-secret.ps1 — meme valeur dans le CRM.
ESPACE_SYNC_SECRET=REMPLACER_PAR_SECRET_LONG

# Brevo — expéditeur valide dans votre compte (ex. votre Gmail).
ESPACE_BREVO_API_KEY=
ESPACE_MAIL_FROM=
ESPACE_MAIL_FROM_NAME=Votre conseiller
# Notification conseiller quand un client dépose un document (email perso, hors dépôt)
ESPACE_ADVISOR_EMAIL=

# Page /confidentialite (optionnel — texte generique si absent)
# ESPACE_PRIVACY_CONTROLLER=Mon Cabinet CGP
# Une mention par ligne (\n litteral dans le .env).
# ESPACE_PRIVACY_CONTROLLER_DETAILS=12 rue des Acacias, 69000 Lyon\nSIREN 000000000\nORIAS 00000000
# ESPACE_PRIVACY_CONTACT_EMAIL=rgpd@example.com
# ESPACE_PRIVACY_UPDATED=aout 2026

# Pas de mode dev en production.
# ESPACE_PORTAL_DEV=0

# Phase 2 depots documents (optionnel tant que non active).
# ESPACE_CLAMD_ADDR=127.0.0.1:3310
