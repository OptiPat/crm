[Unit]
Description=Portail espace client Patrimoine CRM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=espace
Group=espace
WorkingDirectory=/opt/espace-portail
EnvironmentFile=/opt/espace-portail/.env
ExecStart=/opt/espace-portail/bin/espace-portail
Restart=on-failure
RestartSec=5

# Hardening minimal
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/espace-portail/data
PrivateTmp=true
# La base porte emails, patrimoine et journal des connexions : elle naissait
# en 644, lisible par tout compte local. Les fichiers annexes de SQLite
# (-wal, -shm) suivent le meme umask.
UMask=0077

[Install]
WantedBy=multi-user.target
