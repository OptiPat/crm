# Copier ce fichier en .env (ignore par git) et renseigner les valeurs.
# Le .env ne doit JAMAIS etre commite : il contient la cle Brevo.

# Secret partage avec le CRM (Parametres -> Espace client -> Cle API).
# En production : long et aleatoire, different de celui de developpement.
ESPACE_SYNC_SECRET=dev-sync-secret-change-me

# Mode developpement : expose la lecture patrimoine SANS authentification.
# Uniquement en local. Le binaire refuse de demarrer si ce mode est actif
# sur une adresse d'ecoute non locale.
ESPACE_PORTAL_DEV=1

# --- Envoi des codes de connexion (Brevo) ---
# Cle dediee au portail, distincte de celle de la newsletter.
# Laisser vide en dev : les codes s'affichent alors dans les logs.
ESPACE_BREVO_API_KEY=
# Adresse d'expedition, validee comme expediteur dans Brevo.
ESPACE_MAIL_FROM=
# Nom affiche par le client dans sa boite mail.
ESPACE_MAIL_FROM_NAME=Cabinet

# --- Reseau (valeurs par defaut convenables en local) ---
# ESPACE_PORTAL_BIND=127.0.0.1:8787
# ESPACE_PORTAL_DB=espace-portail.db
