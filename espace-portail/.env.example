# Copier ce fichier en .env (ignore par git) et renseigner les valeurs.
# Le .env ne doit JAMAIS etre commite : il contient la cle Brevo.

# Secret partage avec le CRM (Parametres -> Espace client -> Cle API).
# En production : long et aleatoire, different de celui de developpement.
ESPACE_SYNC_SECRET=dev-sync-secret-change-me

# Mode developpement : expose la lecture patrimoine SANS authentification.
# Uniquement en local. Le binaire refuse de demarrer si ce mode est actif
# sur une adresse d'ecoute non locale.
ESPACE_PORTAL_DEV=1

# --- Envoi des codes de connexion (Brevo) ---
# Cle dediee au portail, distincte de celle de la newsletter.
# Laisser vide en dev : les codes s'affichent alors dans les logs.
ESPACE_BREVO_API_KEY=
# Adresse d'expedition, validee comme expediteur dans Brevo.
ESPACE_MAIL_FROM=
# Nom affiche par le client dans sa boite mail.
ESPACE_MAIL_FROM_NAME=Cabinet

# --- Page confidentialite (/confidentialite) — optionnel ---
# Raison sociale ou nom du cabinet (responsable de traitement affiche au client).
# Laisser vide : texte generique « votre conseiller ».
# ESPACE_PRIVACY_CONTROLLER=
# Mentions legales du cabinet, une par ligne (\n) : adresse postale, SIREN,
# numero ORIAS, association professionnelle, autorite de controle.
# ESPACE_PRIVACY_CONTROLLER_DETAILS=
# Email dedie exercice des droits RGPD (lien mailto sur la page).
# ESPACE_PRIVACY_CONTACT_EMAIL=
# Libelle de mise a jour affiche sur la page (defaut : aout 2026).
# ESPACE_PRIVACY_UPDATED=

# --- Ecran de connexion (optionnel) ---
# URL du logo a cote du titre « Espace investisseur » (ex. /branding/logo.png).
# ESPACE_PORTAL_LOGO_URL=
# Sous-titre d'accueil (defaut : Consultez votre patrimoine en toute confidentialite).
# ESPACE_PORTAL_LOGIN_TAGLINE=
# Theme : system (defaut), light ou dark.
# ESPACE_PORTAL_COLOR_SCHEME=dark

# --- Reseau (valeurs par defaut convenables en local) ---
# ESPACE_PORTAL_BIND=127.0.0.1:8787
# ESPACE_PORTAL_DB=espace-portail.db

# --- Production (derriere Caddy / HTTPS) ---
# ESPACE_PRODUCTION=1
# ESPACE_TRUST_PROXY=1

# --- Antivirus depots documents (clamd, phase 2) ---
# ESPACE_CLAMD_ADDR=127.0.0.1:3310
